{
  "name": "@dpvr/minimax-agent",
  "version": "1.0.48",
  "description": "MiniMax Agent toolkit for Node.js backend integration",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "minimax-agent": "dist/cli/minimax-agent.js"
  },
  "files": [
    "dist/**",
    "agents/**",
    "README.md",
    "LICENSE*"
  ],
  "publishConfig": {
    "registry": "http://10.100.1.10:4873"
  },
  "internalPublish": {
    "registry": "http://10.100.1.10:4873",
    "requireUsabilityEntrypoint": true,
    "requiredReadmeInitCommand": "npx minimax-agent",
    "userSmoke": {
      "command": "npx minimax-agent --no-open",
      "timeoutMs": 120000,
      "successPattern": "Starting web server at http://localhost:{PORT}"
    },
    "requiredPackPaths": [
      "dist/",
      "README.md"
    ],
    "forbiddenPackPaths": [
      "runtime/",
      "sessions/",
      "contexts/",
      "logs/",
      "workspace/",
      "release-toolcall-profiles.dev.json",
      "release-toolcall-profiles.local.json",
      ".env"
    ],
    "releaseToolcallGate": {
      "outputRoot": "logs/release-gate-toolcall-context-session",
      "aggregateFile": "release-toolcall-context-gate.json",
      "markdownFile": "release-toolcall-context-gate.md",
      "manualReviewFile": "release-toolcall-context-manual-review.json",
      "requiredRuns": 3,
      "requiredRoundsPerRun": 20,
      "requiredModel": "multi-profile",
      "requiredProfiles": [
        "kimi",
        "deepseek",
        "minimax"
      ],
      "requiredProfileModels": {
        "kimi": "Kimi-k2.6",
        "deepseek": "deepseek-v4-flash",
        "minimax": "MiniMax-M2.7-highspeed"
      },
      "minimumPassRate": 0.9
    }
  },
  "scripts": {
    "clean:dist": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "clean:cache": "node -e \"require('fs').rmSync('node_modules/.cache', { recursive: true, force: true })\"",
    "clean:modules": "node -e \"require('fs').rmSync('node_modules', { recursive: true, force: true })\"",
    "build": "npm run clean:dist && tsc",
    "prepublishOnly": "npm run build:web",
    "publish:check": "npm config get registry && npm whoami --registry http://10.100.1.10:4873",
    "publish:dry-run": "npm run build:web && npm pack --dry-run",
    "publish:private": "npm publish --registry http://10.100.1.10:4873",
    "publish:standard:preflight": "node scripts/private-npm-standard.js --mode preflight",
    "publish:standard": "node scripts/private-npm-standard.js --mode publish",
    "smoke:ui:built": "node scripts/smoke-playwright-ui.js",
    "smoke:ui": "npm run build:web && npm run smoke:ui:built",
    "smoke:ui:responsive": "node scripts/smoke-responsive-ui.js",
    "eval:completion-marker": "node scripts/eval-completion-marker.js",
    "eval:toolcall-context-session": "tsx scripts/eval-toolcall-context-session.ts",
    "test:release-toolcall-context-session:single": "npm run eval:toolcall-context-session -- --rounds 20 --output-root logs/release-gate-toolcall-context-session-single",
    "test:release-toolcall-context-session": "tsx scripts/release-toolcall-context-gate.ts --profiles kimi,deepseek,minimax --rounds 20 --min-pass-rate 0.9 --model multi-profile --run-timeout-ms 900000 --output-root logs/release-gate-toolcall-context-session",
    "release:source-gate": "npm test && npm run build:web && npm run smoke:ui:built && npm run test:release-toolcall-context-session",
    "test:minimax-openai-ux": "node scripts/run-minimax-openai-ux.js",
    "ux:round1": "node scripts/ux-runner.js --round round1",
    "ux:round2": "node scripts/ux-runner.js --round round2",
    "ux:round1:dev": "node scripts/ux-runner.js --round round1 --expect-existing true",
    "ux:round2:dev": "node scripts/ux-runner.js --round round2 --expect-existing true",
    "ux:iterate": "node scripts/ux-iterate.js --rounds 10 --prompts-per-round 6 --expect-existing false",
    "ux:iterate:dev": "node scripts/ux-iterate.js --rounds 10 --prompts-per-round 6 --expect-existing true",
    "ux:long-context": "node scripts/ux-iterate.js --mode long-context --expect-existing false",
    "ux:long-context:dev": "node scripts/ux-iterate.js --mode long-context --expect-existing true",
    "ux:long-context:5": "node scripts/ux-iterate.js --mode long-context --rounds 5 --prompts-per-round 20 --long-output-min-chars 40000 --expect-existing false",
    "ux:long-context:5:dev": "node scripts/ux-iterate.js --mode long-context --rounds 5 --prompts-per-round 20 --long-output-min-chars 40000 --expect-existing true",
    "ux:ui-focused": "node scripts/ux-iterate.js --mode ui-focused --expect-existing false",
    "ux:ui-focused:dev": "node scripts/ux-iterate.js --mode ui-focused --expect-existing true",
    "ux:ui-focused:30:dev": "node scripts/ux-iterate.js --mode ui-focused --rounds 30 --min-rounds 30 --max-rounds 150 --run-hours 8 --prompts-per-round 5 --visual-audit-min-screenshots 5 --expect-existing true",
    "ux:flow": "npm run ux:round1 && npm run ux:round2",
    "dev": "tsc --watch",
    "test": "npm run test:unit",
    "test:unit": "npm run test:subagent && npm run test:subagent-tool && npm run test:subagent-runner && npm run test:agent-finish-reason && npm run test:plan-mode && npm run test:plan-mode-agent-case && npm run test:auto-loop-exit && npm run test:web-port-config && npm run test:web-auto-loop-exit-callback && npm run test:web-ws-message-dispatch && npm run test:web-stop-auto-loop-message && npm run test:web-cancel-message && npm run test:web-chat-message && npm run test:web-callback-assembly && npm run test:web-runtime-watchdog && npm run test:web-callback-completion && npm run test:web-default-mcp-config && npm run test:web-config-provider && npm run test:llm-provider-routing && npm run test:llm-thinking-signature && npm run test:llm-anthropic-tool-protocol && npm run test:llm-openai-compatible && npm run test:minimax-openai-provider-run && npm run test:agents && npm run test:web-llm-profile-routes && npm run test:web-prompt-resolution && npm run test:web-plan-input-normalization && npm run test:web-plan-input-response-messages && npm run test:web-plan-input-response && npm run test:web-request-user-input && npm run test:web-callback-event-messages && npm run test:web-callback-event-dispatcher && npm run test:web-tool-call-state && npm run test:web-composer-input-state && npm run test:web-i18n && npm run test:web-config-modal-ui && npm run test:web-interrupted-artifact-ui && npm run test:workspace-preferences && npm run test:web-memory-organize-ui && npm run test:web-memory-organize-route && npm run test:automation-schedule && npm run test:automation-store && npm run test:web-automation-routes && npm run test:web-automation-scheduler && npm run test:web-automation-execution && npm run test:web-mcp-status && npm run test:mcp-runtime-config && npm run test:mcp-shared-runtime && npm run test:mcp-connector-reconnect && npm run test:mcp-status-ui && npm run test:tool-event-summary && npm run test:tool-registration-dedupe && npm run test:toolset-registry && npm run test:execution-tool-registry-gating && npm run test:context-manage-tool && npm run test:context-payload-projector && npm run test:runtime-platform && npm run test:permission-manager && npm run test:shell-tool && npm run test:read-file-tool && npm run test:memory-store && npm run test:governance-audit-store && npm run test:todo-store && npm run test:skill-draft-store-auto && npm run test:auto-generated-skill-governance && npm run test:skill-loader-progressive && npm run test:skill-loader-precedence && npm run test:skill-pack-store && npm run test:governance-tool-audit && npm run test:markdown-render && npm run test:eval-toolcall-context-session && npm run test:release-toolcall-context-gate && npm run test:private-npm-standard && npm run test:ux-iterate-config-protection && npm run test:context-history-replay && npm run test:compressed-history-context-cache && npm run test:turn-summary-v2 && npm run test:context-overflow && npm run test:p0-session-transcript-search && npm run test:p1-session-toolset-override && npm run test:p2-governance",
