{
  "name": "@dpvr/dpagent",
  "version": "2.3.1",
  "description": "DPVR dedicated local-first Agent runtime for Node.js, Web UI, tools, MCP, memory, skills, subagents, and automation.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "dpagent": "dist/cli/dpagent.js"
  },
  "files": [
    "dist/**",
    "scripts/asr/*.py",
    "scripts/asr/*.ps1",
    "agents/**",
    "skills/**",
    "doc/guide/user-guide.md",
    "doc/guide/assets/user-guide/**",
    "README.md",
    "LICENSE*"
  ],
  "publishConfig": {
    "registry": "http://10.100.1.10:4873"
  },
  "npmOfficialPublish": {
    "packageName": "@lennith/dpagent",
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "internalPublish": {
    "registry": "http://10.100.1.10:4873",
    "requireUsabilityEntrypoint": true,
    "requiredReadmeInitCommand": "npx dpagent",
    "userSmoke": {
      "command": "npx dpagent --no-open",
      "timeoutMs": 120000,
      "successPattern": "Starting web server at http://localhost:{PORT}"
    },
    "requiredPackPaths": [
      "dist/",
      "agents/browser/AGENTS.md",
      "agents/checkpoint/AGENTS.md",
      "agents/coding/AGENTS.md",
      "agents/design/AGENTS.md",
      "agents/dpagent-assistant/AGENTS.md",
      "agents/guard/AGENTS.md",
      "agents/health/AGENTS.md",
      "agents/investigate/AGENTS.md",
      "agents/planner/AGENTS.md",
      "agents/qa/AGENTS.md",
      "agents/release/AGENTS.md",
      "agents/report/AGENTS.md",
      "agents/research/AGENTS.md",
      "agents/review/AGENTS.md",
      "agents/security/AGENTS.md",
      "skills/web-access/SKILL.md",
      "doc/guide/user-guide.md",
      "doc/guide/assets/user-guide/",
      "README.md"
    ],
    "forbiddenPackPaths": [
      "runtime/",
      "sessions/",
      "contexts/",
      "logs/",
      "workspace/",
      "release-toolcall-profiles.dev.json",
      "release-toolcall-profiles.local.json",
      ".env"
    ],
    "releaseToolcallGate": {
      "outputRoot": "logs/release-gate-toolcall-context-session",
      "aggregateFile": "release-toolcall-context-gate.json",
      "markdownFile": "release-toolcall-context-gate.md",
      "manualReviewFile": "release-toolcall-context-manual-review.json",
      "requiredRuns": 3,
      "requiredRoundsPerRun": 10,
      "requiredModel": "multi-profile",
      "requiredProfiles": [
        "deepseek",
        "minimax",
        "xiaomi"
      ],
      "requiredProfileModels": {
        "deepseek": "deepseek-v4-flash",
        "minimax": "MiniMax-M2.7-highspeed",
        "xiaomi": "mimo-v2.5-pro"
      },
      "minimumPassRate": 0.9
    },
    "releaseE2EGate": {
      "outputRoot": "logs/release-gate-e2e",
      "aggregateFile": "release-e2e-gate.json",
      "markdownFile": "release-e2e-gate.md",
      "requiredCases": [
        "e2e:release-agent-web-regression",
        "e2e:release-plan-mode-lifecycle",
        "e2e:release-plan-mode-ux",
        "e2e:release-cli-long-session"
      ]
    }
  },
  "scripts": {
    "clean:dist": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "clean:cache": "node -e \"require('fs').rmSync('node_modules/.cache', { recursive: true, force: true })\"",
    "clean:modules": "node -e \"require('fs').rmSync('node_modules', { recursive: true, force: true })\"",
    "build": "npm run clean:dist && tsc",
    "prepublishOnly": "npm run build:web",
    "publish:check": "npm config get registry && npm whoami --registry http://10.100.1.10:4873",
    "publish:dry-run": "npm run build:web && npm pack --dry-run",
    "publish:private": "npm publish --registry http://10.100.1.10:4873",
    "publish:standard:preflight": "node scripts/private-npm-standard.js --mode preflight",
    "publish:standard": "node scripts/private-npm-standard.js --mode publish",
    "publish:standard:beta:preflight": "node scripts/private-npm-standard.js --mode preflight --tag beta",
    "publish:standard:beta": "node scripts/private-npm-standard.js --mode publish --tag beta",
    "publish:npm-official:preflight": "node scripts/npm-official-publish.js --mode preflight --skip-release-gate",
    "publish:npm-official": "node scripts/npm-official-publish.js --mode publish --skip-release-gate",
    "publish:npm-official:beta:preflight": "node scripts/npm-official-publish.js --mode preflight --tag beta --skip-release-gate",
    "publish:npm-official:beta": "node scripts/npm-official-publish.js --mode publish --tag beta --skip-release-gate",
    "smoke:ui:built": "node scripts/smoke-playwright-ui.js",
    "smoke:ui": "npm run build:web && npm run smoke:ui:built",
    "smoke:ui:responsive": "node scripts/smoke-responsive-ui.js",
    "eval:completion-marker": "node scripts/eval-completion-marker.js",
    "eval:toolcall-context-session": "tsx scripts/eval-toolcall-context-session.ts",
    "test:release-toolcall-context-session:single": "npm run eval:toolcall-context-session -- --rounds 10 --output-root logs/release-gate-toolcall-context-session-single",
    "test:release-toolcall-context-session": "tsx scripts/release-toolcall-context-gate.ts --profiles deepseek,minimax,xiaomi --rounds 10 --min-pass-rate 0.9 --model multi-profile --run-timeout-ms 900000 --output-root logs/release-gate-toolcall-context-session",
    "test:release-e2e": "tsx scripts/release-e2e-gate.ts --tag release-gate --output-root logs/release-gate-e2e",
    "release:source-gate": "npm test && npm run build:web && npm run smoke:ui:built && npm run test:release-e2e && npm run test:release-toolcall-context-session",
    "test:minimax-openai-ux": "node scripts/run-minimax-openai-ux.js",
    "ux:round1": "node scripts/ux-runner.js --round round1",
    "ux:round2": "node scripts/ux-runner.js --round round2",
    "ux:round1:dev": "node scripts/ux-runner.js --round round1 --expect-existing true",
    "ux:round2:dev": "node scripts/ux-runner.js --round round2 --expect-existing true",
    "ux:iterate": "node scripts/ux-iterate.js --rounds 10 --prompts-per-round 6 --expect-existing false",
    "ux:iterate:dev": "node scripts/ux-iterate.js --rounds 10 --prompts-per-round 6 --expect-existing true",
    "ux:long-context": "node scripts/ux-iterate.js --mode long-context --expect-existing false",
    "ux:long-context:dev": "node scripts/ux-iterate.js --mode long-context --expect-existing true",
    "ux:long-context:5": "node scripts/ux-iterate.js --mode long-context --rounds 5 --prompts-per-round 20 --long-output-min-chars 40000 --expect-existing false",
    "ux:long-context:5:dev": "node scripts/ux-iterate.js --mode long-context --rounds 5 --prompts-per-round 20 --long-output-min-chars 40000 --expect-existing true",
    "ux:ui-focused": "node scripts/ux-iterate.js --mode ui-focused --expect-existing false",
    "ux:ui-focused:dev": "node scripts/ux-iterate.js --mode ui-focused --expect-existing true",
    "ux:ui-focused:30:dev": "node scripts/ux-iterate.js --mode ui-focused --rounds 30 --min-rounds 30 --max-rounds 150 --run-hours 8 --prompts-per-round 5 --visual-audit-min-screenshots 5 --expect-existing true",
    "ux:flow": "npm run ux:round1 && npm run ux:round2",
    "dev": "tsc --watch",
    "test": "npm run test:unit && npm run test:integration:default",
    "test:unit": "tsx scripts/run-test-manifest.ts unit",
    "test:agent-finish-reason": "tsx tests/unit/agent-finish-reason-gating.test.ts",
    "test:turn-recovery-policy": "tsx tests/unit/turn-recovery-policy.test.ts",
    "test:persistence": "tsx tests/integration/persistence.test.ts",
    "test:compression": "tsx tests/integration/compression.test.ts",
    "test:mcp": "tsx tests/integration/mcp.test.ts",
    "test:concurrent": "tsx tests/integration/concurrent.test.ts",
    "test:migration": "tsx tests/integration/migration.test.ts",
    "test:skill": "tsx tests/unit/skill.test.ts",
